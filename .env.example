# Environment variables for testing the production build locally
# Copy this file to .env and fill in the values

# Database
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/corekt
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=admin
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

# Security
JWT_SECRET=
JWT_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=604800000

# Encryption (Required)
ENCRYPTION_MASTER_KEY=""
ENCRYPTION_RSA_PRIVATE_KEY=""

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# External APIs
MISTRAL_API_TOKEN=
MISTRAL_ANALYSIS_AGENT_ID=
MISTRAL_PARSED_DATA_AGENT_ID=
SPRING_AI_MISTRALAI_API_KEY=

# Taiga API
TAIGA_API_BASE_URL=https://api.taiga.io/api/v1

# JumpCloud LDAP
JUMPCLOUD_LDAP_URL=""
JUMPCLOUD_LDAP_BASE=""
JUMPCLOUD_LDAP_USERDN=""
JUMPCLOUD_LDAP_PASSWORD=""

# Rate Limiting
RATELIMIT_REQUESTS=50
RATELIMIT_DURATION_MINUTES=1
